# global options (Railway production)
{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

# site block, listens on the $PORT environment variable, automatically assigned by railway
:{$PORT:3000} {
	log {
		format json
	}

	# API는 별도 Railway 서비스(badukstone-api)로 프록시 — CORS 없이 같은 도메인으로 호출
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:http://badukstone-api.railway.internal:3001}
	}

	rewrite /health /*

	root * dist
	encode gzip
	file_server
	try_files {path} /index.html
}
