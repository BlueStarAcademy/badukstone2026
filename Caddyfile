# global options (Railway production)
{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

# site block, listens on the $PORT environment variable, automatically assigned by railway
:{$PORT:3000} {
	log {
		format json
	}

	# Railway/모니터용 헬스체크는 Express JSON을 그대로 노출
	handle /health {
		reverse_proxy {$API_UPSTREAM:http://127.0.0.1:3001}
	}

	# API는 같은 컨테이너의 Express(3001) 또는 Railway 내부 API 서비스로 프록시
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:http://127.0.0.1:3001}
	}

	handle {
		root * dist
		encode gzip
		file_server
		try_files {path} /index.html
	}
}
